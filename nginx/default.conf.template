# Внешний edge (ngrok/Railway) терминирует TLS и шлёт X-Forwarded-Proto;
# сам nginx TLS не терминирует, поэтому доверяем этому заголовку, а если
# его нет (прямой локальный запуск без туннеля) — используем свою схему.
map $http_x_forwarded_proto $forwarded_scheme {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};

    # Заголовки безопасности. always — чтобы они ставились и на ответы с
    # ошибками (4xx/5xx), а не только на 2xx/3xx.
    #
    # CSP: 'unsafe-inline' для стилей нужен из-за инлайновых style-атрибутов,
    # которые генерируют Tailwind-компоненты и ApexCharts; для скриптов он НЕ
    # выдан. connect-src разрешает своё же происхождение (фронт ходит на
    # /api того же хоста) и blob: для выгрузок PDF/Excel. img-src включает
    # data: (QR-коды в base64) и https: (логотип компании и картинки товаров
    # из R2).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS имеет смысл только когда наружу торчит https (его терминирует
    # внешний edge — Render/Railway); по http браузер заголовок игнорирует.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }

    # Локальный backend в этом же контейнере (uvicorn на 127.0.0.1:8000).
    # Префикс /api/ отрезается nginx — backend отвечает на свои обычные
    # пути (/auth, /users, ...) без префикса.
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_scheme;
        # FastAPI редиректит на пути без учёта /api-префикса (его добавляет
        # только nginx) — перезаписываем Location обратно под /api/.
        proxy_redirect ~^https?://[^/]+/(.*)$ $forwarded_scheme://$http_host/api/$1;
    }
}
