DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/crm_db
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Super Admin
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Email (Resend) — оставьте RESEND_API_KEY пустым, чтобы отключить отправку писем
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Служебный токен для POST /tasks/reminders/process — без него ручной/внешний
# запуск обработки напоминаний недоступен (эндпоинт вернёт 403). Основной
# механизм — встроенный планировщик (см. TASK_REMINDER_INTERVAL_MINUTES),
# этот эндпоинт нужен только для ручного/операционного триггера.
TASK_REMINDER_TOKEN=
TASK_REMINDER_INTERVAL_MINUTES=2
